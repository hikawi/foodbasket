  "query": "\n        SELECT id, tenant_id, branch_id, name, statements AS \"statements: Json<PolicyDocument>\", created_at, updated_at, deleted_at\n        FROM policies\n        WHERE tenant_id = $1 AND (branch_id IS NULL OR $2::uuid IS NULL OR branch_id = $2)\n        OFFSET $3\n        LIMIT $4\n        ",
